{
  "name": "smartbonus",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smartbonus-waitlist",
      "database_id": "2d13fea8-e4a8-427d-a55c-12e340a07ea5"
    }
  ],
  "keep_vars": true,
  "observability": { "enabled": true }
}
